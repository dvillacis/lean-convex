    value: 10.5281/zenodo.24530553
    description: "All versions (the DOI of the latest version resolves from here)"
repository-code: "https://github.com/dvillacis/lean-convex"
url: "https://david.villacis.net/lean-convex/docs/"
keywords:
  - Lean 4
  - Mathlib
  - formalized mathematics
  - convex analysis
  - optimization
references:
