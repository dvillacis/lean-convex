import Mathlib

/-!
# The cone of feasible directions of a convex set

For a convex set `B` and `u ∈ B`, `feasCone B u = {t (v - u) | t ≥ 0, v ∈ B}` is the cone
generated by `B - u`. Its closure is the tangent cone of `B` at `u`, and it is the polar of the
normal cone `N_B(u) = {ν | ∀ v ∈ B, ⟪ν, v - u⟫ ≤ 0}` (`mem_closure_feasCone`). This is the
geometric step in first-order optimality conditions over convex sets: a one-sided directional
derivative that is nonnegative along `B - u`, positively homogeneous and continuous is
nonnegative on the closure of `feasCone B u`.

* `convex_feasCone`: `feasCone B u` is convex.
* `mem_closure_feasCone`: if `⟪ν, d⟫ ≤ 0` for all `ν ∈ N_B(u)`, then `d ∈ closure (feasCone B u)`.
* `hasDerivAt_clm_ray`: `ε ↦ L (u + ε d)` has derivative `L d` (derivatives along rays).
-/

open Set InnerProductSpace
open scoped RealInnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A continuous linear map along a ray has derivative `L d`. -/
lemma hasDerivAt_clm_ray {W : Type*} [NormedAddCommGroup W] [NormedSpace ℝ W]
    (L : E →L[ℝ] W) (u d : E) : HasDerivAt (fun ε : ℝ => L (u + ε • d)) (L d) 0 := by
  have : (fun ε : ℝ => L (u + ε • d)) = fun ε => ε • L d + L u := by
    funext ε; rw [map_add, map_smul, add_comm]
  rw [this]
  simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (L d)).add_const (L u)

/-- The cone generated by `B - u`. -/
def feasCone (B : Set E) (u : E) : Set E := {d | ∃ t : ℝ, 0 ≤ t ∧ ∃ v ∈ B, d = t • (v - u)}

lemma convex_feasCone {B : Set E} (hB : Convex ℝ B) (u : E) : Convex ℝ (feasCone B u) := by
  rintro _ ⟨t₁, ht₁, v₁, hv₁, rfl⟩ _ ⟨t₂, ht₂, v₂, hv₂, rfl⟩ a b ha hb hab
  by_cases hs : a * t₁ + b * t₂ = 0
  · have h1 : a * t₁ = 0 := by nlinarith [mul_nonneg ha ht₁, mul_nonneg hb ht₂]
    have h2 : b * t₂ = 0 := by nlinarith [mul_nonneg ha ht₁, mul_nonneg hb ht₂]
    refine ⟨0, le_rfl, v₁, hv₁, ?_⟩
    rw [smul_smul, smul_smul, h1, h2]
    simp
  · have hpos : 0 < a * t₁ + b * t₂ :=
      lt_of_le_of_ne (by positivity) (Ne.symm hs)
    set w := (a * t₁ / (a * t₁ + b * t₂)) • v₁ + (b * t₂ / (a * t₁ + b * t₂)) • v₂
    have hw : w ∈ B := hB hv₁ hv₂ (by positivity) (by positivity) (by field_simp)
    refine ⟨a * t₁ + b * t₂, hpos.le, w, hw, ?_⟩
    simp only [w, smul_sub, smul_add, smul_smul]
    rw [mul_div_cancel₀ _ hs, mul_div_cancel₀ _ hs]
    module

/-- Bipolar property: a direction `d` with `⟪ν, d⟫ ≤ 0` for every `ν ∈ N_B(u)` lies in the
closure of the cone generated by `B - u`. -/
theorem mem_closure_feasCone {B : Set E} (hB : Convex ℝ B) {u : E} (hu : u ∈ B) {d : E}
    [CompleteSpace E]
    (hd : ∀ ν : E, (∀ v ∈ B, ⟪ν, v - u⟫ ≤ 0) → ⟪ν, d⟫ ≤ 0) :
    d ∈ closure (feasCone B u) := by
  by_contra hnot
  obtain ⟨ℓ, α, hℓ, hαd⟩ := geometric_hahn_banach_closed_point
    (convex_feasCone hB u).closure isClosed_closure hnot
  try simp only [RCLike.re_to_real] at hℓ hαd
  have hα : 0 < α := by
    have := hℓ 0 (subset_closure ⟨0, le_rfl, u, hu, by simp⟩)
    simpa using this
  set ν := (toDual ℝ E).symm ℓ
  have hν : ∀ x, ⟪ν, x⟫ = ℓ x := fun x => toDual_symm_apply
  -- `ν ∈ N_B(u)`, by scaling inside the cone
  have hN : ∀ v ∈ B, ⟪ν, v - u⟫ ≤ 0 := by
    intro v hv
    rw [hν]
    by_contra hpos
    push Not at hpos
    have := hℓ ((α / ℓ (v - u) + 1) • (v - u))
      (subset_closure ⟨_, by positivity, v, hv, rfl⟩)
    rw [map_smul, smul_eq_mul, add_mul, div_mul_cancel₀ _ hpos.ne', one_mul] at this
    linarith
  have := hd ν hN
  rw [hν] at this
  linarith
